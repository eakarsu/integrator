{
  "name": "integrator-backend",
  "version": "1.0.0",
  "description": "System Integrator Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "provision": "node src/scripts/provision.js",
    "create-admin": "node src/scripts/provision.js",
    "worker": "node src/worker.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "check": "node --check src/server.js && node --check src/routes/workflows.js && node --check src/services/workflowEngine.js && node --check src/worker.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "zod": "^4.3.6"
  }
}
