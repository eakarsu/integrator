NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://integrator:replace-me@127.0.0.1:5432/integrator
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
CONNECTOR_TIMEOUT_MS=10000
CONNECTOR_MAX_RESPONSE_BYTES=1048576
DB_POOL_SIZE=10
ALLOW_PRIVATE_CONNECTOR_HOSTS=false
ALLOW_INSECURE_CONNECTOR_HTTP=false

# Used only by `npm run provision`; remove from the environment after provisioning.
PROVISION_TENANT_NAME=
PROVISION_ADMIN_NAME=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=
